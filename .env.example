# ---------------------------------------------------------------------------
# AskCENLA Repair Network — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put a Supabase service_role key or a Stripe secret key in this file.
# ---------------------------------------------------------------------------

# Phase 2 — Supabase (safe to expose: the anon key is protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 10 — Stripe (publishable key only; secret keys live in server functions)
VITE_STRIPE_PUBLISHABLE_KEY=

# Data source: "mock" runs the app on local demo data with no backend.
# Switch to "supabase" once Phase 2 is wired up.
VITE_DATA_SOURCE=mock
