# ---------------------------------------------------------------------------
# AskCENLA Repair Network — environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put a Supabase service_role key or a Stripe secret key in this file —
# they bypass Row Level Security and would be readable by anyone.
#
# With no .env file the app runs on in-memory demo data, which is a supported
# mode: a fresh clone always works.
# ---------------------------------------------------------------------------

# Supabase — Project Settings -> API -> Project URL and the `anon` `public` key.
# The anon key is safe to expose: every request it makes is filtered by the RLS
# policies in supabase/migrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Data source.
#   (blank)   — auto: uses Supabase when the two values above are set,
#               otherwise falls back to demo data.
#   mock      — force demo data even when credentials are present.
#   supabase  — require Supabase; fail loudly at startup if it is not configured.
VITE_DATA_SOURCE=

# Phase 10 — Stripe. Publishable key only; the secret key lives in an Edge
# Function, never in this file.
VITE_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Local tooling only. Not read by the app, and not prefixed with VITE_ so it
# can never leak into the browser bundle.
# ---------------------------------------------------------------------------

# Used by `npm run db:test` to point at a local PostgreSQL server.
# Leave blank to use a local database named askcenla_test on the default socket.
DATABASE_URL=

# Used by `npm run db:types`. Find it in your Supabase project URL.
SUPABASE_PROJECT_ID=
