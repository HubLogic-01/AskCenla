{
  "name": "askcenla-repair-network",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AskCENLA Repair Network \u2014 repair-request workflow platform for real estate agents, brokers, and contractors.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
